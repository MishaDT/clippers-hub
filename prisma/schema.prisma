generator client {
  provider      = "prisma-client-js"
  // native = build host; rhel targets = Netlify Functions (AWS Lambda) runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String             @id @default(cuid())
  email                   String             @unique
  emailVerifiedAt         DateTime?
  passwordHash            String
  name                    String
  handle                  String             @unique
  avatar                  String?
  bio                     String?
  specialtiesJson         String             @default("[]")
  socialLinksJson         String             @default("[]")
  handleChangedAt         DateTime?
  accountStatus           AccountStatus      @default(ACTIVE)
  isDemo                  Boolean            @default(false)
  restrictionReason       String?
  restrictedUntil         DateTime?
  role                    Role               @default(WORKER)
  balanceCents            Int                @default(0)
  holdBalanceCents        Int                @default(0)
  rpBalance               Int                @default(0)
  rpPurchasedBalance      Int                @default(0)
  preferredRoleMode       String?
  collabAvailability      CollabAvailability @default(ACTIVE_ROLE)
  marketGuideSeenAt       DateTime?
  rank                    Rank               @default(BRONZE)
  trustScore              Int                @default(100)
  streakDays              Int                @default(0)
  lifetimeViews           Int                @default(0)
  referredBy              String?
  referralCode            String             @unique
  kycStatus               KYCStatus          @default(NONE)
  payoutInn               String?
  payoutAccount           String?
  payoutBik               String?
  payoutFullName          String?
  payoutPhone             String?
  selfEmployedConfirmedAt DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  ownedCampaigns            Campaign[]               @relation("CampaignOwner")
  submissions               Submission[]
  transactions              Transaction[]
  socialAccounts            SocialAccount[]
  oauthAccounts             OAuthAccount[]
  notifications             Notification[]
  achievements              UserAchievement[]
  disputes                  DisputeCase[]
  auditLogs                 AuditLog[]
  businessLeads             BusinessLead[]           @relation("LeadUser")
  assignedBusinessLeads     BusinessLead[]           @relation("LeadAssignee")
  savedCampaigns            SavedCampaign[]
  likedCampaigns            LikedCampaign[]
  analyticsEvents           AnalyticsEvent[]
  clientChats               ChatThread[]             @relation("ChatClient")
  workerChats               ChatThread[]             @relation("ChatWorker")
  sentChatMessages          ChatMessage[]            @relation("ChatSender")
  chatReadStates            ChatReadState[]
  supportThreads            SupportThread[]          @relation("SupportRequester")
  assignedSupportThreads    SupportThread[]          @relation("SupportAssignee")
  sentSupportMessages       SupportMessage[]         @relation("SupportSender")
  collabSent                CollabInvite[]           @relation("CollabClient")
  collabReceived            CollabInvite[]           @relation("CollabWorker")
  endorsementsGiven         Endorsement[]            @relation("EndorseClient")
  endorsementsReceived      Endorsement[]            @relation("EndorseWorker")
  handleAliases             UserHandleAlias[]
  portfolioPins             PortfolioPin[]
  moderationAuthored        ModerationCase[]         @relation("ModerationAuthor")
  moderationReported        ModerationCase[]         @relation("ModerationReporter")
  moderationReviewed        ModerationCase[]         @relation("ModerationReviewer")
  messageAudits             ChatMessageEdit[]        @relation("MessageEditor")
  rpTransactions            RpTransaction[]
  recurringRewardClaims     RecurringRewardClaim[]
  storeRedemptions          StoreRedemption[]
  emailVerificationTokens   EmailVerificationToken[]
  referralsSent             ReferralRelation[]       @relation("ReferralReferrer")
  referralRelation          ReferralRelation?        @relation("ReferralReferred")
  referralCommissions       ReferralCommission[]     @relation("ReferralCommissionOwner")
  referralCommissionSources ReferralCommission[]     @relation("ReferralCommissionSource")
  referralClicks            ReferralClick[]
  collabInitiated           CollabInvite[]           @relation("CollabInitiator")
  ratingsGiven              UserRating[]             @relation("RatingAuthor")
  ratingsReceived           UserRating[]             @relation("RatingSubject")
  invoiceRequests           InvoiceRequest[]

  @@index([role, createdAt])
  @@index([isDemo, role, createdAt])
  @@index([createdAt])
}

// Bank-transfer top-up requests for business (юрлицо) clients. Admin confirms receipt,
// which credits the balance via the normal atomic DEPOSIT path (idempotent on provider+ref).
model InvoiceRequest {
  id          String    @id @default(cuid())
  userId      String
  amountCents Int
  inn         String
  companyName String
  status      String    @default("NEW")
  adminId     String?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model SocialAccount {
  id                    String    @id @default(cuid())
  userId                String
  platform              Platform
  externalId            String
  handle                String
  accessToken           String?
  refreshToken          String?
  tokenExpiresAt        DateTime?
  refreshTokenExpiresAt DateTime?
  scopesJson            String    @default("[]")
  verifiedAt            DateTime?
  verificationMethod    String?
  accountUrl            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
  @@index([userId, platform])
}

// Social login (Google / VK / Yandex). Stores ONLY the identity link —
// no access/refresh tokens are kept (we never act on the user's behalf).
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Campaign {
  id                     String         @id @default(cuid())
  ownerId                String
  title                  String
  description            String
  sourceUrl              String
  sourcePlatform         Platform
  allowedPlatformsJson   String
  rulesJson              String
  cpmRateCents           Int
  viewThreshold          Int
  minimumGuaranteeCents  Int            @default(0)
  reviewMode             ReviewMode     @default(STANDARD)
  maxRevisionRounds      Int            @default(2)
  briefVersion           Int            @default(1)
  draftRequired          Boolean        @default(true)
  totalBudgetCents       Int
  remainingBudgetCents   Int
  reservedBudgetCents    Int            @default(0)
  maxPaidResults         Int            @default(1)
  status                 CampaignStatus @default(ACTIVE)
  visibility             Visibility     @default(PUBLIC)
  trackingPrefix         String         @unique
  deadline               DateTime
  language               String         @default("ru")
  niche                  String?
  metricsJson            String         @default("{}")
  briefJson              String         @default("{}")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  moderationStatus       String         @default("APPROVED")
  featuredUntil          DateTime?
  isDemo                 Boolean        @default(false)
  badgeBonusCpmCents     Int            @default(0)
  isPlatformOrganized    Boolean        @default(false)
  requireVerifiedAccount Boolean        @default(false)
  isAdvertising          Boolean        @default(true)
  erid                   String?
  advertiserInn          String?
  advertiserName         String?

  owner         User            @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  submissions   Submission[]
  savedBy       SavedCampaign[]
  likedBy       LikedCampaign[]
  chatThreads   ChatThread[]
  collabInvites CollabInvite[]

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@index([featuredUntil])
}

model SavedCampaign {
  id         String   @id @default(cuid())
  userId     String
  campaignId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
}

model LikedCampaign {
  id         String   @id @default(cuid())
  userId     String
  campaignId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
}

model Submission {
  id                    String            @id @default(cuid())
  campaignId            String
  workerId              String
  postUrl               String
  platform              Platform
  platformPostId        String
  trackingCode          String            @unique
  currentViews          Int               @default(0)
  currentLikes          Int               @default(0)
  currentComments       Int               @default(0)
  peakViews             Int               @default(0)
  status                SubmissionStatus  @default(POSTED)
  fraudScore            Int               @default(0)
  reservedPayoutCents   Int               @default(0)
  reservationReleasedAt DateTime?
  draftUrl              String?
  draftStatus           DraftReviewStatus @default(NOT_SUBMITTED)
  draftRevision         Int               @default(0)
  draftSubmittedAt      DateTime?
  draftReviewedAt       DateTime?
  draftReviewNote       String?
  draftReviewedById     String?
  publishApprovedAt     DateTime?
  acceptedBriefVersion  Int?
  badgeConfirmedAt      DateTime?
  earlyRemovalAt        DateTime?
  shareToken            String?           @unique
  viewVelocityJson      String            @default("[]")
  lastSyncedAt          DateTime          @default(now())
  verifiedAt            DateTime?
  paidAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  worker        User           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  disputes      DisputeCase[]
  chatThreads   ChatThread[]
  videoChecks   VideoCheck[]
  portfolioPins PortfolioPin[]
  ratings       UserRating[]

  @@unique([campaignId, workerId])
  @@index([workerId, createdAt])
  @@index([workerId, currentViews])
  @@index([campaignId, currentViews])
  @@index([status, fraudScore])
  @@index([draftStatus, draftSubmittedAt])
}

model UserRating {
  id           String     @id @default(cuid())
  submissionId String
  authorId     String
  subjectId    String
  authorRole   RatingRole
  score        Int
  comment      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User       @relation("RatingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject    User       @relation("RatingSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([submissionId, authorId])
  @@index([subjectId, createdAt])
  @@index([subjectId, score])
}

model VideoCheck {
  id           String   @id @default(cuid())
  submissionId String
  checkType    String   @default("WATERMARK")
  status       String   @default("PENDING")
  score        Int      @default(0)
  resultJson   String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([submissionId])
}

model ChatThread {
  id               String    @id @default(cuid())
  kind             String    @default("CAMPAIGN")
  campaignId       String?
  collabInviteId   String?   @unique
  submissionId     String?
  clientId         String
  workerId         String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  clientArchivedAt DateTime?
  workerArchivedAt DateTime?
  clientClearedAt  DateTime?
  workerClearedAt  DateTime?

  campaign     Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  collabInvite CollabInvite?   @relation(fields: [collabInviteId], references: [id], onDelete: Cascade)
  submission   Submission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  client       User            @relation("ChatClient", fields: [clientId], references: [id], onDelete: Cascade)
  worker       User            @relation("ChatWorker", fields: [workerId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]
  readStates   ChatReadState[]

  @@unique([campaignId, workerId])
  @@index([kind, updatedAt])
  @@index([clientId, updatedAt])
  @@index([workerId, updatedAt])
}

model ChatMessage {
  id               String    @id @default(cuid())
  threadId         String
  senderId         String
  body             String
  type             String    @default("TEXT")
  metadataJson     String    @default("{}")
  moderationStatus String    @default("APPROVED")
  createdAt        DateTime  @default(now())
  editedAt         DateTime?
  deletedAt        DateTime?

  thread ChatThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User              @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  edits  ChatMessageEdit[]

  @@index([threadId, createdAt])
  @@index([senderId, createdAt])
}

// Immutable audit trail of every chat message edit/delete (admin visibility).
model ChatMessageEdit {
  id           String   @id @default(cuid())
  messageId    String
  threadId     String
  editorId     String
  previousBody String
  newBody      String?
  action       String   @default("EDIT")
  createdAt    DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editor  User        @relation("MessageEditor", fields: [editorId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@index([threadId, createdAt])
  @@index([createdAt])
}

model UserHandleAlias {
  id        String   @id @default(cuid())
  userId    String
  handle    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PortfolioPin {
  id           String   @id @default(cuid())
  userId       String
  submissionId String
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([userId, submissionId])
  @@unique([userId, position])
  @@index([userId, position])
}

model ModerationCase {
  id          String    @id @default(cuid())
  source      String
  contentType String
  entityId    String?
  authorId    String?
  reporterId  String?
  reviewerId  String?
  category    String
  severity    String
  status      String    @default("OPEN")
  excerpt     String?
  payloadJson String    @default("{}")
  resolution  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reviewedAt  DateTime?

  author   User? @relation("ModerationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reporter User? @relation("ModerationReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewer User? @relation("ModerationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, severity, createdAt])
  @@index([authorId, createdAt])
  @@index([entityId, contentType])
}

model ChatReadState {
  id         String   @id @default(cuid())
  threadId   String
  userId     String
  lastReadAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, lastReadAt])
}

model SupportThread {
  id              String          @id @default(cuid())
  requesterId     String
  assignedToId    String?
  subject         String
  category        SupportCategory
  status          SupportStatus   @default(OPEN)
  priority        SupportPriority @default(NORMAL)
  requesterReadAt DateTime        @default(now())
  adminReadAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  resolvedAt      DateTime?

  requester  User             @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignedTo User?            @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportMessage[]

  @@index([requesterId, updatedAt])
  @@index([status, priority, updatedAt])
  @@index([assignedToId, status, updatedAt])
}

model SupportMessage {
  id           String   @id @default(cuid())
  threadId     String
  senderId     String
  body         String
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("SupportSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([senderId, createdAt])
}

model Transaction {
  id           String            @id @default(cuid())
  userId       String
  submissionId String?
  amountCents  Int
  feeCents     Int               @default(0)
  netCents     Int
  type         TransactionType
  status       TransactionStatus @default(COMPLETED)
  isDemo       Boolean           @default(false)
  provider     String?
  providerRef  String?
  providerData String            @default("{}")
  createdAt    DateTime          @default(now())

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission          Submission?          @relation(fields: [submissionId], references: [id])
  referralCommissions ReferralCommission[]

  @@unique([provider, providerRef])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([isDemo, status, type, createdAt])
  @@index([submissionId, type])
}

model BusinessLead {
  id              String             @id @default(cuid())
  userId          String?
  assignedAdminId String?
  name            String
  contact         String
  contentUrl      String?
  budgetCents     Int                @default(0)
  goal            String
  source          String             @default("landing")
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  status          BusinessLeadStatus @default(NEW)
  notes           String             @default("")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user          User? @relation("LeadUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedAdmin User? @relation("LeadAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([assignedAdminId, status])
  @@index([source, createdAt])
}

model ReferralProgramConfig {
  id                 String   @id @default("default")
  enabled            Boolean  @default(true)
  attributionDays    Int      @default(30)
  activationRewardRp Int      @default(25)
  updatedAt          DateTime @updatedAt
}

model ReferralTier {
  id                 String   @id @default(cuid())
  title              String
  minActiveReferrals Int      @unique
  rateBps            Int
  sortOrder          Int      @default(0)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active, minActiveReferrals])
}

model ReferralRelation {
  id             String         @id @default(cuid())
  referrerId     String
  referredUserId String         @unique
  codeSnapshot   String
  status         ReferralStatus @default(REGISTERED)
  qualifiedAt    DateTime?
  flaggedAt      DateTime?
  flagReason     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  referrer     User                 @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User                 @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  commissions  ReferralCommission[]

  @@index([referrerId, status, createdAt])
}

model ReferralCommission {
  id             String                   @id @default(cuid())
  referrerId     String
  referredUserId String
  relationId     String
  transactionId  String
  side           ReferralCommissionSide
  rateBps        Int
  baseFeeCents   Int
  amountCents    Int
  status         ReferralCommissionStatus @default(AVAILABLE)
  releasedAt     DateTime?
  reversedAt     DateTime?
  createdAt      DateTime                 @default(now())

  referrer     User             @relation("ReferralCommissionOwner", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User             @relation("ReferralCommissionSource", fields: [referredUserId], references: [id], onDelete: Cascade)
  relation     ReferralRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  transaction  Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, referredUserId])
  @@index([referrerId, status, createdAt])
  @@index([referredUserId, createdAt])
}

model ReferralClick {
  id            String   @id @default(cuid())
  referrerId    String
  codeSnapshot  String
  ipHash        String?
  userAgentHash String?
  landingPath   String?
  createdAt     DateTime @default(now())

  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
  @@index([ipHash, createdAt])
}

model Notification {
  id              String    @id @default(cuid())
  userId          String
  groupKey        String?
  title           String
  body            String
  channel         String
  priority        String
  kind            String    @default("GENERAL")
  href            String?
  occurrenceCount Int       @default(1)
  readAt          DateTime?
  archivedAt      DateTime?
  lastOccurredAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupKey])
  @@index([userId, readAt, priority])
  @@index([userId, archivedAt, lastOccurredAt])
}

enum SupportCategory {
  PAYMENT
  CAMPAIGN
  SUBMISSION
  ACCOUNT
  SECURITY
  OTHER
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Achievement {
  id          String            @id @default(cuid())
  code        String            @unique
  title       String
  description String
  icon        String
  users       UserAchievement[]
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime  @default(now())
  claimedAt     DateTime?
  rewardRp      Int       @default(0)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model RpTransaction {
  id           String   @id @default(cuid())
  userId       String
  amount       Int
  type         String
  reference    String   @unique
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model RecurringRewardClaim {
  id        String   @id @default(cuid())
  userId    String
  code      String
  periodKey String
  rewardRp  Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code, periodKey])
  @@index([userId, periodKey])
}

model StoreOffer {
  id            String            @id @default(cuid())
  kind          String            @default("RP_REWARD")
  source        String?
  externalId    String?           @unique
  category      String?
  provider      String?
  title         String
  description   String
  url           String?
  imageUrl      String?
  qrImageUrl    String?
  licenseNumber String?
  disclaimer    String?
  featuresJson  String            @default("[]")
  priceRp       Int               @default(0)
  stock         Int?
  active        Boolean           @default(true)
  featured      Boolean           @default(false)
  sortOrder     Int               @default(0)
  metadataJson  String            @default("{}")
  importedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  redemptions   StoreRedemption[]

  @@index([active, sortOrder])
  @@index([kind, active])
  @@index([source, category, active])
}

model StoreRedemption {
  id              String    @id @default(cuid())
  userId          String
  offerId         String
  costRp          Int
  purchasedRpUsed Int       @default(0)
  status          String    @default("NEW")
  contactEmail    String
  adminNote       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  fulfilledAt     DateTime?
  refundedAt      DateTime?

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer StoreOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([offerId, createdAt])
}

model LeaderboardSnapshot {
  id          String   @id @default(cuid())
  season      String
  type        String
  handle      String
  rank        Int
  views       Int
  payoutCents Int
  createdAt   DateTime @default(now())
}

model DisputeCase {
  id            String    @id @default(cuid())
  userId        String
  submissionId  String
  reason        String
  status        String    @default("OPEN")
  resolution    String?
  resolvedById  String?
  platformFault Boolean   @default(false)
  openKey       String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resolvedAt    DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  userId        String?
  type          String
  path          String?
  provider      String?
  ipHash        String?
  userAgentHash String?
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([provider, createdAt])
  @@index([ipHash, createdAt])
}

// Client -> clipper collaboration request (joint clip).
model CollabInvite {
  id          String    @id @default(cuid())
  clientId    String
  workerId    String
  initiatorId String
  campaignId  String?
  role        String    @default("Клиппер")
  deadline    DateTime?
  message     String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  cancelledAt DateTime?
  endedAt     DateTime?

  client     User        @relation("CollabClient", fields: [clientId], references: [id], onDelete: Cascade)
  worker     User        @relation("CollabWorker", fields: [workerId], references: [id], onDelete: Cascade)
  initiator  User        @relation("CollabInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  chatThread ChatThread?

  @@index([workerId, status])
  @@index([clientId, status])
  @@index([campaignId, status])
  @@index([initiatorId, status])
}

// A large client endorsing a clipper ("{client} рекомендует").
model Endorsement {
  id        String   @id @default(cuid())
  clientId  String
  workerId  String
  note      String?
  createdAt DateTime @default(now())

  client User @relation("EndorseClient", fields: [clientId], references: [id], onDelete: Cascade)
  worker User @relation("EndorseWorker", fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([clientId, workerId])
  @@index([workerId])
}

