{
  "name": "clippers-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:init": "node scripts/init-db.js",
    "db:founders": "node scripts/seed-founder-showcase.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:backfill-collabs": "node scripts/backfill-collab-chats.js",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test:providers": "node --experimental-strip-types --test tests/view-providers.test.mts",
    "test:avatar": "node --experimental-strip-types --test tests/avatar-image.test.mts",
    "test:policy": "node --experimental-strip-types --test tests/content-policy.test.mts",
    "test:profile": "node --experimental-strip-types --test tests/profile-rules.test.mts",
    "test:rp": "node --experimental-strip-types --test tests/rp-rewards.test.mts",
    "test:auth-intent": "node --experimental-strip-types --test tests/auth-intent.test.mts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
    "prisma": "^6.10.1",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
