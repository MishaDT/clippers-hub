# --- БАЗА ДАННЫХ (PostgreSQL, напр. Supabase / Neon) ---
# Pooled connection (через pgbouncer) — для приложения:
DATABASE_URL="postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
# Прямое подключение — для миграций и seed:
DIRECT_URL="postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres"
# E2E must use an isolated schema/database. Never point this at production public schema.
DATABASE_URL_TEST="postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres?schema=reelpay_e2e"

# --- СЕССИИ ---
# Любая длинная случайная строка (32+ символов). Сгенерировать: openssl rand -base64 32
SESSION_SECRET="change-me-before-production"
ADMIN_EMAILS="owner@example.com"
ANALYTICS_SALT="change-me-before-production-analytics-salt"

# --- ПУБЛИЧНЫЙ АДРЕС САЙТА ---
# Можно не задавать на Vercel: он сам даст VERCEL_URL.
# Если подключим свой домен, сюда ставим его, например:
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# --- ВХОД ЧЕРЕЗ СОЦСЕТИ (OAuth) ---
# Кнопка появляется автоматически, как только заданы CLIENT_ID и SECRET провайдера.
# Базовый адрес для redirect URI. Если не задан — берётся NEXT_PUBLIC_SITE_URL, затем origin запроса.
# ВАЖНО: должен ТОЧНО совпадать с тем, что прописан в консоли провайдера.
OAUTH_REDIRECT_BASE="https://your-domain.vercel.app"
# Redirect URI для каждого провайдера: {OAUTH_REDIRECT_BASE}/api/auth/oauth/{google|vk|yandex}/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""

# --- Платежи (без ключей production-пополнение отключено) ---
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Production fails closed when provider keys are missing.
# Unpaid demo deposits must be enabled explicitly for local development or tests.
DEMO_PAYMENTS="false"

# Optional malicious URL reputation checks (no AI).
# No external requests are made when these keys are empty.
URLHAUS_AUTH_KEY=""
PHISHTANK_API_KEY=""

# --- Синхронизация просмотров (опционально, иначе мок-данные) ---
YOUTUBE_DATA_API_KEY=""
VK_SERVICE_TOKEN=""

# --- Проверка публикаций через OAuth соцсетей (необязательно) ---
# Отдельный случайный ключ для AES-256-GCM шифрования access/refresh токенов в базе.
# Минимум 32 символа. Не используйте SESSION_SECRET и не меняйте ключ без ротации токенов.
SOCIAL_TOKEN_ENCRYPTION_KEY=""
# Rotatable keyring. First entry encrypts new tokens; keep old entries until all
# credentials are re-encrypted. Format: current:32+chars,previous:32+chars
SOCIAL_TOKEN_ENCRYPTION_KEYS=""
# Separate HMAC key for per-submission signed QR. Falls back to SESSION_SECRET,
# but an independent 32+ character production secret is recommended.
VISUAL_PROOF_SECRET=""
# Read-only YouTube channel connection (scope youtube.readonly).
# Redirect URI: {OAUTH_REDIRECT_BASE}/api/social/oauth/youtube/callback
YOUTUBE_OAUTH_CLIENT_ID=""
YOUTUBE_OAUTH_CLIENT_SECRET=""
# TikTok: Login Kit + Display API, scopes user.info.basic и video.list.
# Redirect URI: {OAUTH_REDIRECT_BASE}/api/social/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Instagram будет включён после настройки и проверки приложения Meta.
# Redirect URI: {OAUTH_REDIRECT_BASE}/api/social/oauth/instagram/callback
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# Рекламная карусель в правой колонке лидерборда.
# Только HTTPS-ссылки. qrDataUrl — готовое HTTPS/data:image изображение QR-кода.
# Пример: [{"id":"card","eyebrow":"Партнёр","title":"Дебетовая карта","description":"Описание без скрытых условий","ctaLabel":"Посмотреть условия","href":"https://partner.example/ref","qrDataUrl":"https://partner.example/qr.png"}]
AFFILIATE_OFFERS_JSON="[]"

# --- ПОЧТА И ПОДДЕРЖКА ---
# Resend: подтверждение email и восстановление пароля. Домен отправителя должен быть подтверждён в Resend.
RESEND_API_KEY=""
EMAIL_FROM="ReelPay <no-reply@your-domain.ru>"
SUPPORT_EMAIL="support@your-domain.ru"

# --- СЛУЖЕБНЫЕ ЗАДАЧИ И ЗАГРУЗКИ ---
# 32+ случайных символа. Vercel Cron передаёт значение как Bearer-токен.
CRON_SECRET=""
# Нужен для прямой загрузки черновиков видео в Vercel Blob. Без него остаётся сдача по HTTPS-ссылке.
BLOB_READ_WRITE_TOKEN=""
# Общий rate limit между serverless-инстансами. Без него действует только базовая локальная защита.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
ANALYTICS_RETENTION_DAYS="90"

# --- ЮРИДИЧЕСКИЕ РЕКВИЗИТЫ ОПЕРАТОРА ---
LEGAL_OPERATOR_NAME=""
LEGAL_OPERATOR_ID=""
LEGAL_OPERATOR_ADDRESS=""

# --- ВЫПЛАТЫ ---
# Сейчас production поддерживает контролируемые ручные выплаты через админку с номером перевода и чеком.
PAYOUT_PROVIDER="manual"

# --- НЕОБЯЗАТЕЛЬНЫЙ TELEGRAM-ДАЙДЖЕСТ ---
TELEGRAM_ENABLED="0"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""

# Совместимый псевдоним основного адреса для webhook/email-ссылок.
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
